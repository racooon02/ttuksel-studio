rules_version = '2';
/*
 * 뚝셀 스튜디오 Firestore 보안 규칙
 * Firebase 콘솔 > Firestore Database > 규칙 탭에 붙여넣고 게시하세요.
 *
 * 관리자 인증:
 * - 관리 탭은 Firebase Auth(관리자 계정)로 로그인합니다.
 *   상태 변경·삭제는 아래 isAdmin()이 확인하는 관리자 UID로만
 *   허용됩니다. 로그인하지 않은 방문자는 제안 생성과 투표만
 *   할 수 있습니다.
 * - 투표는 "투표수 ±1 + 내 토큰 추가/제거"만 허용해, 임의의 숫자로
 *   투표수를 바꾸는 쓰기를 막습니다. (기기 토큰은 익명 값입니다)
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isVoteOnlyChange() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['votes', 'voters'])
        && request.resource.data.votes >= 0
        && (request.resource.data.votes == resource.data.votes + 1
            || request.resource.data.votes == resource.data.votes - 1);
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'CZdYSCf7JkeR4VICx55pQcazfdG3';
    }

    function isStatusChangeOnly() {
      // 관리 경로: 상태 전이만 허용 (pending → voting → building → done)
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['status'])
        && request.resource.data.status in ['voting', 'building', 'done']
        && (
          (resource.data.status == 'pending'  && request.resource.data.status == 'voting') ||
          (resource.data.status == 'voting'   && request.resource.data.status == 'building') ||
          (resource.data.status == 'building' && request.resource.data.status == 'done')
        );
    }

    match /proposals/{id} {
      // 읽기: 공개 (대기 중 포함 — 관리 탭이 같은 컬렉션을 읽음)
      allow get, list: if true;

      // 생성: 반드시 대기(pending) 상태, 투표 0, 투표자 없음으로만
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.votes == 0
        && request.resource.data.voters.size() == 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 40
        && request.resource.data.keys().hasOnly(['title', 'pain', 'author', 'status', 'votes', 'voters', 'createdAt']);

      // 수정: 투표 전용 변경은 누구나, 상태 전이는 관리자만
      allow update: if isVoteOnlyChange() || (isAdmin() && isStatusChangeOnly());

      // 삭제: 관리자만 (반려·삭제)
      allow delete: if isAdmin();
    }

    // 그 외 경로는 전부 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
